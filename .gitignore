# Visual Studio & MSVC
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build artifacts
out/
build/
CMakeSettings.json
CMakeUserPresets.json

# Test executables (rebuilt from source; not shipping artifacts)
bin/Release/
bin/Debug/
bin/*.obj

# vcpkg
vcpkg_installed/

# Compiled Binaries & PDBs
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.obj
*.o

# Package archives
*.zip
*.7z
*.rar
*.tar.gz

# Logs & temp
*.log
tmp/
temp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------------------
# Required shipping artifacts — keep these tracked despite the patterns above.
# The packaging pipeline (scripts/PackageMod.ps1) depends on TrueGaze.dll
# being present in skyrim/SKSE/Plugins/.
# ---------------------------------------------------------------------------
!skyrim/SKSE/Plugins/TrueGaze.dll
!dist/
!dist/*.zip

# ---------------------------------------------------------------------------
# Generated one-click launchers.
#
# scripts/Install-OneClick.ps1 writes these on demand. They are not tracked
# because each one embeds an absolute path to this machine's checkout, which
# would be wrong for anyone else and would churn on every clone location.
# Regenerate with:  .\scripts\Install-OneClick.ps1
# ---------------------------------------------------------------------------
/*.lnk
/TrueGaze.cmd
