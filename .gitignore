# Visual Studio & MSVC
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# ---------------------------------------------------------------------------
# Prerequisite downloads.
#
# Install-Prerequisites.ps1 stages SKSE and the Address Library here. These are
# upstream third-party binaries and must never be committed (the Address Library's
# permissions forbid redistribution). The folder is a scratch area that the
# installer fills on the user's own machine.
# ---------------------------------------------------------------------------
downloads/

# ---------------------------------------------------------------------------
# Local scratch space.
#
# Ad-hoc verification scripts and one-off probes live here. They are not part of
# the product and are never packaged; keeping them out of the index stops them
# being mistaken for shipped tooling.
# ---------------------------------------------------------------------------
scratch/

# Build artifacts
out/
build/
CMakeSettings.json
CMakeUserPresets.json

# Test executables (rebuilt from source; not shipping artifacts)
bin/Release/
bin/Debug/
bin/*.obj

# vcpkg
vcpkg_installed/

# Compiled Binaries & PDBs
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.obj
*.o

# Package archives
*.zip
*.7z
*.rar
*.tar.gz

# Logs & temp
*.log
tmp/
temp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Release staging directories (keep dist/ folder tracked, ignore generated archives)
dist/*/
!dist/

# ---------------------------------------------------------------------------
# Generated one-click shortcuts.
#
# These embed an absolute path to this machine's checkout, so they would be
# wrong for anyone else and would churn on every clone location. Regenerate
# with:  .\scripts\Install-OneClick.ps1
#
# TrueGaze.cmd is NOT ignored: it is the self-contained batch entry point and
# resolves its own location, so it works from any checkout.
# ---------------------------------------------------------------------------
/*.lnk
